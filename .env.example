# DepthWizard Environment Configuration

# OpenTopography API Key (free from https://portal.opentopography.org/apidocs/)
OPENTOPO_API_KEY=

# Server configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080

# Computation & Storage
DEVICE=auto
MAX_UPLOAD_PX=8000
JOBS_DIR=jobs
MODELS_DIR=models
CACHE_DIR=data/cache
DEFAULT_MODEL_CHECKPOINT=models/depth_anything_v2_vits.pth
FT_MODEL_CHECKPOINT=models/dav2s_gamus_ft_v1.pth
